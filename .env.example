# Copy to .env.local (local dev) and set the same keys in Hostinger → Node.js app → Environment variables.
# GHL Private Integration token. Scopes: contacts.write, contacts.readonly, forms.write, opportunities.readonly, opportunities.write
GHL_TOKEN=
# GHL → Settings → Business Profile → Location ID
GHL_LOCATION_ID=
# Contact custom field "Job Photos" (File Upload). Optional: photo links still go in the contact note.
GHL_FILE_FIELD_ID=
# Pipeline + stage for new website leads (GET /opportunities/pipelines). Optional.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Hermes AI API (same gateway as the Omniwink/Wopie routines). Used only by scripts/blog-image-hermes.mjs
# to generate blog photos; not needed by the website itself.
AI_API_URL=
AI_API_KEY=
