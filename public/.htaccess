# Apache config for the static export (Hostinger, cPanel and other Apache hosts).
# Replaces the redirects() and headers() that lived in next.config.ts before the switch to output: "export".
# Every URL in the live sitemap (48) is served at the exact same path, so these rules only catch
# common variants/guesses and the apex domain, so nothing that used to resolve now 404s.

Options -MultiViews -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Apex → www and HTTP → HTTPS (canonical host on the live site).
RewriteCond %{HTTP_HOST} ^nationalrubbishremoval\.com\.au$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.nationalrubbishremoval.com.au/$1 [R=301,L,NE]

# Strip trailing slashes (trailingSlash: false), except on real directories' index.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Aliases.
RewriteRule ^(home|index|index\.html)$ / [R=301,L]
RewriteRule ^about-us$ /about [R=301,L]
RewriteRule ^(contact-us|get-a-quote|quote|free-quote|book|booking)$ /contact [R=301,L]
RewriteRule ^(pricing|prices|price|cost|calculator|estimator)$ /quote-estimator [R=301,L]
RewriteRule ^(locations|service-areas|areas)$ /location [R=301,L]
RewriteRule ^(privacy|privacy-policy)$ /policy [R=301,L]
RewriteRule ^(terms-and-conditions|terms-of-service)$ /terms [R=301,L]
RewriteRule ^residential-rubbish-removal$ /services#residential-rubbish-removal [R=301,L,NE]
RewriteRule ^commercial-rubbish-removal$ /services#commercial-rubbish-removal [R=301,L,NE]
RewriteRule ^construction-rubbish-removal$ /services#construction-rubbish-removal [R=301,L,NE]
RewriteRule ^skip-bin-alternative$ /skip-bin-alternatives [R=301,L]
RewriteRule ^furniture-removal$ /unwanted-furniture-removal [R=301,L]
RewriteRule ^(garage-cleanout|garage-clean-up)$ /garage-clean-out [R=301,L]

# /services/<slug> → /<slug>
RewriteRule ^services/(household-rubbish-removal|green-waste-removal|deceased-estate-clearance|unwanted-furniture-removal|garage-clean-out|mattress-removal|strata-rubbish-removal|office-rubbish-removal|office-cubicle-removal|retail-strip-out-removal|warehouse-rubbish-removal|end-of-lease-rubbish-removal|building-materials-disposal|construction-site-clean-up|scrap-metal-removal|brick-and-concrete-removal|timber-removal|skip-bin-alternatives)$ /$1 [R=301,L]

# /rubbish-removal-<suburb> → /<suburb>
RewriteRule ^rubbish-removal-(.+)$ /$1 [R=301,L]

# Clean URLs: /about → about.html (the export writes one .html file per route).
# No "!-d" check: the export also writes an about/ folder of RSC payloads next to about.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

<FilesMatch "\.(webp|jpg|jpeg|png|svg|avif|ico)$">
Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
</FilesMatch>
</IfModule>

# Next's hashed build assets never change, so cache them for a year.
<IfModule mod_headers.c>
<If "%{REQUEST_URI} =~ m#^/_next/static/#">
Header set Cache-Control "public, max-age=31536000, immutable"
</If>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

AddType text/plain .txt
AddType application/xml .xml
